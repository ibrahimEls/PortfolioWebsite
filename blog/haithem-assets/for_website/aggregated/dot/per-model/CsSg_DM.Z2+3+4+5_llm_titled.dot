root_yes_yes_yes_s0 [label=<<B>LLM-Agent Literature Split</B><BR/>Cluster-merger dark-matter<BR/>self-interaction bound<BR/>σ<SUB><FONT POINT-SIZE="9">&#8202;self&#8202;</FONT></SUB>/m<SUB><FONT POINT-SIZE="9">&#8202;DM&#8202;</FONT></SUB> &gt; 0.47<BR/>cm²/g ?<BR/>arXiv:0704.0261,<BR/>arXiv:1503.07675<BR/><B>Status: No Split!</B>>, shape=box, style="rounded,filled", fillcolor=gold];
